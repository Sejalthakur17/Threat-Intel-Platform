<!--
  Custom Wazuh detection rules for Threat Intelligence Platform
  Place in: /var/ossec/etc/rules/local_rules.xml on Wazuh manager
-->

<group name="threat-intel-platform,">

  <!-- Rule 1: SSH brute force — 5 failures in 2 minutes -->
  <rule id="100001" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip/>
    <description>SSH brute force attack: 5 failed logins from same IP in 2 minutes</description>
    <mitre>
      <id>T1110.001</id>  <!-- Brute Force: Password Guessing -->
    </mitre>
    <group>authentication_failure,brute_force,</group>
  </rule>

  <!-- Rule 2: Root login via SSH (should never happen) -->
  <rule id="100002" level="12">
    <if_sid>5715</if_sid>
    <match>root</match>
    <description>Root login via SSH detected — investigate immediately</description>
    <mitre>
      <id>T1078.003</id>  <!-- Valid Accounts: Local Accounts -->
    </mitre>
    <group>authentication_success,privilege_escalation,</group>
  </rule>

  <!-- Rule 3: Suspicious cron job added -->
  <rule id="100003" level="8">
    <if_sid>533</if_sid>
    <match>/etc/cron|/var/spool/cron</match>
    <description>Cron file modified — possible persistence mechanism</description>
    <mitre>
      <id>T1053.003</id>  <!-- Scheduled Task/Job: Cron -->
    </mitre>
    <group>syscheck,persistence,</group>
  </rule>

  <!-- Rule 4: Docker socket accessed (container escape risk) -->
  <rule id="100004" level="9">
    <if_sid>554</if_sid>
    <match>/var/run/docker.sock</match>
    <description>Docker socket accessed — potential container escape attempt</description>
    <mitre>
      <id>T1611</id>  <!-- Escape to Host -->
    </mitre>
    <group>docker,container_security,</group>
  </rule>

  <!-- Rule 5: App returning high error rate (500s) -->
  <rule id="100005" level="6" frequency="20" timeframe="60">
    <if_matched_group>web_log</if_matched_group>
    <match>HTTP/1.[01]" 5</match>
    <description>App generating high 5xx error rate — 20+ errors in 60 seconds</description>
    <group>web_error,availability,</group>
  </rule>

  <!-- Rule 6: Outbound connection to known threat feed IOC -->
  <rule id="100006" level="14">
    <if_sid>4100</if_sid>
    <description>Outbound connection matches known malicious IOC in threat database</description>
    <mitre>
      <id>T1071</id>  <!-- Application Layer Protocol C2 -->
    </mitre>
    <group>threat_intel,c2,</group>
  </rule>

</group>
